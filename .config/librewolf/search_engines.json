{
    "version": 1,
    "default": "Google",
    "engines": [
        {
            "Name": "Google",
            "URLTemplate": "https://www.google.com/search?q={searchTerms}",
            "Method": "GET",
            "SuggestURLTemplate": "https://www.google.com/complete/search?client=chrome&q={searchTerms}",
            "IconURL": "data:image/png;base64,"
        },
        {
            "Name": "zh.wikipedia.org",
            "URLTemplate": "https://zh.wikipedia.org/w/index.php?search={searchTerms}&title=Special%3ASearch&wprov=acrw1_-1",
            "Method": "GET",
            "Alias": "zhwiki",
            "IconURL": "data:image/png;base64,"
        },
        {
            "Name": "www.youtube.com",
            "URLTemplate": "https://www.youtube.com/results?search_query={searchTerms}",
            "Method": "GET",
            "Alias": "youtube",
            "IconURL": "data:image/png;base64,"
        },
        {
            "Name": "wiki.archlinux.org",
            "URLTemplate": "https://wiki.archlinux.org/index.php?search={searchTerms}&title=Special%3ASearch&wprov=acrw1_-1",
            "Method": "GET",
            "Alias": "wiki.arch",
            "IconURL": "data:image/png;base64,"
        },
        {
            "Name": "bgm.tv",
            "URLTemplate": "https://bgm.tv/subject_search/{searchTerms}?cat=2",
            "Method": "GET",
            "Alias": "bgm.tv",
            "IconURL": "data:image/png;base64,"
        },
        {
            "Name": "amazon.ca",
            "URLTemplate": "https://www.amazon.ca/s?k={searchTerms}&emi=A3DWYIK6Y9EEQB",
            "Method": "GET",
            "Alias": "amazon.ca",
            "IconURL": "data:image/png;base64,"
        },
        {
            "Name": "Honkai: Star Rail Wiki",
            "URLTemplate": "https://honkai-star-rail.fandom.com/wiki/{searchTerms}",
            "Method": "GET",
            "Alias": "honkai",
            "IconURL": "data:image/png;base64,"
        }
    ]
}
